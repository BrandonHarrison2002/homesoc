[Unit]
Description=HomeSOC network discovery scan (one-shot)
Documentation=https://github.com/BrandonHarrison2002/homesoc
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/brandon/homesoc
ExecStart=/usr/bin/python3 /home/brandon/homesoc/scanners/discovery.py
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homesoc-discovery

[Install]
WantedBy=multi-user.target
